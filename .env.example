# ==================== ENVIRONMENT VARIABLES FOR PRODUCTION ====================
# DO NOT COMMIT THIS FILE WITH REAL VALUES!
# Copy to .env.production and fill in real values (which is gitignored)

# ==================== DATABASE CONNECTION ====================
# ClickHouse connection string
# Replace with your production ClickHouse server details
ConnectionStrings__ClickHouse=Host=prod-clickhouse.example.com;Port=8123;Database=fraud_detection_prod;Username=fraud_user;Password=SECURE_PROD_PASSWORD_HERE

# ==================== NOTIFICATION SERVICES ====================
# Microsoft Teams Webhook URL for production alerts
# Get this from: Teams > Channel > Connectors > Incoming Webhook
Notifications__TeamsWebhook=https://outlook.office.com/webhook/YOUR-PRODUCTION-TEAMS-WEBHOOK-URL

# Telegram Bot Token for critical alerts
# Get this from: @BotFather on Telegram
Notifications__TelegramBotToken=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_YOUR_REAL_TOKEN

# Telegram Chat ID where alerts will be sent
# Get this by messaging your bot and checking: https://api.telegram.org/bot<TOKEN>/getUpdates
Notifications__TelegramChatId=-1001234567890

# ==================== OPTIONAL: OVERRIDE ML SETTINGS IN PRODUCTION ====================
# ML__TrainingIntervalHours=6
# ML__MinSessionsForTraining=1000
# ML__ScoringIntervalSeconds=10
# ML__ScoringBatchSize=100

# ==================== OPTIONAL: OVERRIDE ALERT SETTINGS ====================
# Alerts__EnableDatabasePersistence=true
# Alerts__DefaultThrottleWindowMinutes=60

# ==================== ASPNETCORE ENVIRONMENT ====================
ASPNETCORE_ENVIRONMENT=Production

# ==================== NOTES ====================
# 1. Use double underscores (__) instead of colons (:) in environment variable names
#    Example: ConnectionStrings:ClickHouse becomes ConnectionStrings__ClickHouse
#
# 2. For Docker, add these to docker-compose.yml:
#    environment:
#      - ConnectionStrings__ClickHouse=Host=...
#      - Notifications__TeamsWebhook=https://...
#
# 3. For Kubernetes, create a Secret:
#    kubectl create secret generic fraud-detection-secrets \
#      --from-literal=ConnectionStrings__ClickHouse='Host=...' \
#      --from-literal=Notifications__TelegramBotToken='...'
#
# 4. For systemd service, create /etc/frauddetection/environment file
#
# 5. For Azure App Service, add in Configuration > Application Settings
