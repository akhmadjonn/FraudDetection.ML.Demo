# ==================== SYSTEMD ENVIRONMENT FILE ====================
# Location: /etc/frauddetection/secrets.env
# Permissions: chmod 600 /etc/frauddetection/secrets.env
# Owner: chown frauddetection:frauddetection /etc/frauddetection/secrets.env

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Production

# ==================== DATABASE CONNECTION ====================
ConnectionStrings__ClickHouse=Host=localhost;Port=8123;Database=fraud_detection;Username=fraud_user;Password=YOUR_SECURE_PASSWORD

# ==================== NOTIFICATION SERVICES ====================
Notifications__TeamsWebhook=https://outlook.office.com/webhook/YOUR-PRODUCTION-WEBHOOK
Notifications__TelegramBotToken=YOUR_TELEGRAM_BOT_TOKEN
Notifications__TelegramChatId=YOUR_TELEGRAM_CHAT_ID

# ==================== ML SETTINGS (Optional Overrides) ====================
ML__TrainingIntervalHours=6
ML__MinSessionsForTraining=1000
ML__ScoringIntervalSeconds=10
ML__ScoringBatchSize=100
ML__DailyReportHour=8

# ==================== ALERT SETTINGS (Optional Overrides) ====================
Alerts__EnableDatabasePersistence=true
Alerts__DefaultThrottleWindowMinutes=60
